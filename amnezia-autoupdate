#!/usr/bin/env bash
#
# amnezia-autoupdate: ежедневное обновление ОС и серверных контейнеров Amnezia VPN.
#
# Как это работает
#   * Контейнеры собираются по официальным серверным скриптам приложения Amnezia
#     (github.com/amnezia-vpn/amnezia-client, папка client/server_scripts) из
#     последнего релиза, теми же Dockerfile и run_container.sh, что использует приложение.
#   * Перед заменой контейнера его /opt/amnezia (ключи сервера, клиенты, clientsTable,
#     start.sh) копируется и переносится в новый контейнер, поэтому выданные
#     пользователям конфиги продолжают работать.
#   * Новый контейнер проверяется: интерфейс поднят, порт и ключ сервера прежние,
#     число клиентов совпадает. Если проверка не прошла, возвращается старый контейнер.
#
# Запуск: amnezia-autoupdate help

set -uo pipefail
umask 077
export LC_ALL=C

VERSION="1.2.0"
PROG="amnezia-autoupdate"

CONF_FILE="${AAU_CONF:-/etc/amnezia-autoupdate.conf}"
STATE_DIR="${AAU_STATE_DIR:-/var/lib/amnezia-autoupdate}"
BACKUP_ROOT="${AAU_BACKUP_DIR:-/var/backups/amnezia-autoupdate}"
LOG_FILE="${AAU_LOG_FILE:-/var/log/amnezia-autoupdate.log}"
LOCK_FILE="${AAU_LOCK_FILE:-/run/amnezia-autoupdate.lock}"

# ---------------------------------------------------------------- настройки по умолчанию
# Любую из них можно переопределить в /etc/amnezia-autoupdate.conf
UPSTREAM_REPO="amnezia-vpn/amnezia-client"
UPSTREAM_REF="latest"        # latest = последний релиз, или тег, например 5.1.0.6
UPSTREAM_LOCAL_DIR=""        # локальная копия client/server_scripts (для тестов и без интернета)
OS_UPDATE="yes"              # обновлять пакеты ОС
CONTAINERS_UPDATE="yes"      # обновлять контейнеры Amnezia
HOST_SETUP="yes"             # заново применять setup_host_firewall.sh (после перезагрузки он теряется)
REBOOT="if-needed"           # if-needed | never | always
FORCE_REBUILD_DAYS="0"       # пересобирать контейнер раз в N дней, даже если ничего не изменилось (0 = нет)
KEEP_BACKUPS="10"            # сколько последних резервных копий /opt/amnezia хранить для каждого контейнера
MIN_FREE_MB="1500"           # минимум свободного места для сборки образа
LOG_MAX_MB="10"              # журнал циклический: сверх этого размера (МБ) старые записи отрезаются, 0 = без ограничения
HEALTH_TIMEOUT="60"          # сколько секунд ждать, пока новый контейнер заработает
NOTIFY="changes"             # changes | errors | always | never (уведомления в Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_COMMANDS="yes"      # отвечать на команды в Telegram (/status), только чату TELEGRAM_CHAT_ID
TELEGRAM_API="${AAU_TELEGRAM_API:-https://api.telegram.org}"   # адрес Bot API (другой нужен только тестам)
SERVER_NAME=""               # имя сервера в уведомлениях (по умолчанию hostname)
SELF_UPDATE_URL="https://raw.githubusercontent.com/iF-22/amnezia-autoupdate/main/amnezia-autoupdate"   # откуда брать новую версию этого скрипта

