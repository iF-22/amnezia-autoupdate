# ---------------------------------------------------------------- Telegram
TG_CODE=""
TG_ERR=""

# Вызов Bot API: tg_api МЕТОД ФАЙЛ_ОТВЕТА [параметры curl]. Возвращает 0, если Telegram
# ответил ok, иначе код HTTP в TG_CODE (000 = нет связи) и текст ошибки в TG_ERR.
# Адрес с токеном curl получает через stdin, чтобы токена не было в списке процессов.
tg_api() {
  local method=$1 out=$2 url
  shift 2
  url="${TELEGRAM_API%/}/bot${TELEGRAM_BOT_TOKEN}/${method}"
  url=${url//\\/\\\\}
  url=${url//\"/\\\"}
  : > "$out"
  TG_CODE=$(printf 'url = "%s"\n' "$url" | curl -sS -K - -o "$out" -w '%{http_code}' "$@" 2> "$out.err")
  [[ $TG_CODE =~ ^[0-9]{3}$ ]] || TG_CODE=000
  if [[ $TG_CODE == 200 && $(jq -r '.ok' "$out" 2>/dev/null) == true ]]; then
    TG_ERR=""
    return 0
  fi
  TG_ERR=$(jq -r '[(.error_code // empty | tostring), (.description // empty)] | join(" ")' "$out" 2>/dev/null)
  [[ -n $TG_ERR ]] || TG_ERR=$(sed -E 's/^curl: \([0-9]+\) //' "$out.err" 2>/dev/null | head -n 1)
  [[ -n $TG_ERR ]] || TG_ERR="HTTP $TG_CODE"
  return 1
}

# Сообщение Telegram не длиннее 4096 символов: обрезаем по целым строкам, с запасом
tg_trim() { awk -v max=3900 '{ n += length($0) + 1; if (n > max) { print "…"; exit } print }'; }

tg_send() {   # tg_send ЧАТ ТЕКСТ
  tg_api sendMessage "${WORK:-/tmp}/tg-send.json" --max-time 20 \
    --data-urlencode "chat_id=$1" --data-urlencode "text=$(printf '%s\n' "$2" | tg_trim)"
}

notify() {
  [[ -n $TELEGRAM_BOT_TOKEN && -n $TELEGRAM_CHAT_ID ]] || return 0
  tg_send "$TELEGRAM_CHAT_ID" "$1" \
    || printf '%s ВНИМАНИЕ: не удалось отправить уведомление в Telegram: %s\n' "$(ts)" "$TG_ERR"
}

# ---------------------------------------------------------------- общее
load_config() {
  if [[ -f $CONF_FILE ]]; then
    local owner
    owner=$(stat -c %u "$CONF_FILE" 2>/dev/null || echo 0)
    [[ $owner == 0 ]] || die "$CONF_FILE должен принадлежать root"
    # shellcheck source=/dev/null
    . "$CONF_FILE"
  fi
  [[ $KEEP_BACKUPS =~ ^[0-9]+$ ]] || KEEP_BACKUPS=10
  [[ $MIN_FREE_MB =~ ^[0-9]+$ ]] || MIN_FREE_MB=1500
  [[ $LOG_MAX_MB =~ ^[0-9]+$ ]] || LOG_MAX_MB=10
  [[ $HEALTH_TIMEOUT =~ ^[0-9]+$ ]] || HEALTH_TIMEOUT=60
  [[ $FORCE_REBUILD_DAYS =~ ^[0-9]+$ ]] || FORCE_REBUILD_DAYS=0
}

need_root() { [[ $EUID -eq 0 ]] || die "нужны права root, запусти через sudo"; }

init_work() {
  WORK=$(mktemp -d /tmp/amnezia-autoupdate.XXXXXX) || die "не могу создать временную папку"
  trap cleanup_work EXIT
  # Скрипты приложения вызывают sudo. Мы уже root; если sudo нет, подставляем заглушку.
  if ! command -v sudo >/dev/null 2>&1; then
    SHIM_DIR="$WORK/shim"
    mkdir -p "$SHIM_DIR"
    cat > "$SHIM_DIR/sudo" <<'EOF'
#!/bin/sh
while [ $# -gt 0 ]; do
  case "$1" in
    -u|-g|-p|-C) shift 2 ;;
    --) shift; break ;;
    -*) shift ;;
    *) break ;;
  esac
done
[ $# -eq 0 ] && exit 0
exec "$@"
EOF
    chmod 755 "$SHIM_DIR/sudo"
    export PATH="$SHIM_DIR:$PATH"
  fi
}

cleanup_work() { [[ -n $WORK && -d $WORK ]] && rm -rf "$WORK"; }

acquire_lock() {
  exec 9>"$LOCK_FILE" || die "не могу открыть $LOCK_FILE"
  if ! flock -n 9; then
    log "уже идёт другой запуск $PROG, жду до 30 минут"
    flock -w 1800 9 || die "другой запуск $PROG не завершился за 30 минут"
  fi
}

start_logging() {
  mkdir -p "$(dirname "$LOG_FILE")"
  trim_log
  exec > >(tee -a "$LOG_FILE") 2>&1
}

# Журнал циклический: когда он больше LOG_MAX_MB, самые старые записи отрезаются
# и остаются последние три четверти. До версии 1.1.0 журнал раз в неделю
# ротировал logrotate, это правило больше не нужно.
trim_log() {
  local max size
  rm -f /etc/logrotate.d/amnezia-autoupdate
  max=$((LOG_MAX_MB * 1024 * 1024))
  (( max > 0 )) || return 0
  size=$(stat -c %s "$LOG_FILE" 2>/dev/null) || return 0
  (( size > max )) || return 0
  tail -c $((max * 3 / 4)) "$LOG_FILE" | sed '1d' > "$LOG_FILE.tmp" && mv -f "$LOG_FILE.tmp" "$LOG_FILE"
}

have_docker() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

valid_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( $1 >= 1 && $1 <= 65535 )); }
valid_ipv4() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
valid_tag()  { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]; }

primary_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit }}'
}

free_mb() { df -Pm "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }

docker_root() { docker info -f '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker; }

# Ежедневная уборка: висячие образы, кэш сборки Docker, кэш пакетов
cleanup_light() {
  if have_docker; then
    docker image prune -f >/dev/null 2>&1
    docker builder prune -af >/dev/null 2>&1
  fi
  if command -v apt-get >/dev/null 2>&1; then apt-get clean >/dev/null 2>&1; fi
  if command -v dnf >/dev/null 2>&1; then dnf clean packages >/dev/null 2>&1; fi
}

# Когда места мало: то же плюс старые журналы
cleanup_disk() {
  cleanup_light
  if command -v journalctl >/dev/null 2>&1; then journalctl --vacuum-size=100M >/dev/null 2>&1; fi
}

ensure_free_space() {
  local path=$1 free
  free=$(free_mb "$path")
  [[ -z $free ]] && return 0
  (( free >= MIN_FREE_MB )) && return 0
  log "свободно ${free} МБ (нужно ${MIN_FREE_MB}), чищу старые образы, кэш сборки и apt"
  cleanup_disk
  free=$(free_mb "$path")
  (( free >= MIN_FREE_MB ))
}

# ---------------------------------------------------------------- скрипты приложения Amnezia
resolve_upstream_tag() {
  local url tag
  if [[ -n $UPSTREAM_LOCAL_DIR ]]; then printf 'local'; return 0; fi
  if [[ $UPSTREAM_REF != latest ]]; then
    valid_tag "$UPSTREAM_REF" || return 1
    printf '%s' "$UPSTREAM_REF"
    return 0
  fi
  # Редирект страницы последнего релиза не тратит лимит GitHub API
  url=$(curl -fsSL --max-time 30 -o /dev/null -w '%{url_effective}' \
        "https://github.com/${UPSTREAM_REPO}/releases/latest" 2>/dev/null) || url=""
  tag=${url##*/releases/tag/}
  if [[ -n $url && $tag != "$url" ]] && valid_tag "$tag"; then printf '%s' "$tag"; return 0; fi
  tag=$(curl -fsSL --max-time 30 "https://api.github.com/repos/${UPSTREAM_REPO}/releases/latest" 2>/dev/null \
        | jq -r '.tag_name // empty' 2>/dev/null) || tag=""
  if [[ -n $tag ]] && valid_tag "$tag"; then printf '%s' "$tag"; return 0; fi
  return 1
}

# fetch_file TAG RELPATH DEST -> 0 скачан, 2 нет такого файла, 1 ошибка сети
fetch_file() {
  local tag=$1 rel=$2 dst=$3 code
  if [[ -n $UPSTREAM_LOCAL_DIR ]]; then
    [[ -f $UPSTREAM_LOCAL_DIR/$rel ]] || return 2
    cp "$UPSTREAM_LOCAL_DIR/$rel" "$dst" || return 1
  else
    code=$(curl -sS -L --max-time 60 --retry 3 --retry-delay 5 -o "$dst" -w '%{http_code}' \
           "https://raw.githubusercontent.com/${UPSTREAM_REPO}/${tag}/client/server_scripts/${rel}" 2>/dev/null) || code=000
    case $code in
      200) ;;
      404) rm -f "$dst"; return 2 ;;
      *)   rm -f "$dst"; return 1 ;;
    esac
  fi
  sed -i 's/\r$//' "$dst"   # приложение тоже убирает \r перед загрузкой на сервер
  return 0
}

use_cached_upstream() {
  local cur="$STATE_DIR/upstream/current"
  if [[ -f $cur/.complete ]]; then
    UP=$(readlink -f "$cur")
    UP_TAG=$(cat "$cur/.tag")
    warn "$1; использую сохранённые скрипты релиза $UP_TAG"
    return 0
  fi
  fail "$1, а сохранённых скриптов нет"
  return 1
}

# Скачивает серверные скрипты нужного релиза в $STATE_DIR/upstream/<тег> и выставляет UP, UP_TAG
prepare_upstream() {
  [[ -n $UP ]] && return 0
  local tag dir tmp f folder rc
  if ! tag=$(resolve_upstream_tag); then
    use_cached_upstream "не удалось узнать последний релиз ${UPSTREAM_REPO}"
    return $?
  fi
  dir="$STATE_DIR/upstream/$tag"
  if [[ $tag != local && -f $dir/.complete ]]; then
    UP=$dir; UP_TAG=$tag
    ln -sfn "$dir" "$STATE_DIR/upstream/current"
    log "серверные скрипты Amnezia: релиз $UP_TAG"
    return 0
  fi
  mkdir -p "$STATE_DIR/upstream"
  tmp=$(mktemp -d "$STATE_DIR/upstream/.download.XXXXXX")
  for f in "${SHARED_SCRIPTS[@]}"; do
    fetch_file "$tag" "$f" "$tmp/$f"; rc=$?
    if (( rc != 0 )); then
      rm -rf "$tmp"
      use_cached_upstream "не удалось скачать $f из релиза $tag"
      return $?
    fi
  done
  for folder in $(printf '%s\n' "${FOLDER_OF[@]}" | sort -u); do
    mkdir -p "$tmp/$folder"
    for f in "${FOLDER_SCRIPTS[@]}"; do
      fetch_file "$tag" "$folder/$f" "$tmp/$folder/$f"; rc=$?
      if (( rc == 1 )) || { (( rc == 2 )) && [[ $f == Dockerfile || $f == run_container.sh ]]; }; then
        rm -rf "$tmp"
        use_cached_upstream "не удалось скачать $folder/$f из релиза $tag"
        return $?
      fi
    done
  done
  printf '%s\n' "$tag" > "$tmp/.tag"
  touch "$tmp/.complete"
  rm -rf "$dir"
  mv "$tmp" "$dir"
  ln -sfn "$dir" "$STATE_DIR/upstream/current"
  UP=$dir; UP_TAG=$tag
  # оставляем три последних релиза
  find "$STATE_DIR/upstream" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | tail -n +4 | cut -d' ' -f2- | while read -r old; do
        [[ $old == "$dir" ]] || rm -rf "$old"
      done
  log "серверные скрипты Amnezia: релиз $UP_TAG"
  return 0
}

# Подстановка переменных так же, как в приложении: простая замена $ИМЯ на значение.
# Длинные имена заменяются первыми, чтобы $AWG_SUBNET_IP не задел $AWG_SUBNET_IP_X.
render() {
  local src=$1 dst=$2 content kv k v
  content=$(<"$src")
  while IFS= read -r kv; do
    [[ -z $kv ]] && continue
    k=${kv%%=*}
    v=${kv#*=}
    content=${content//"\$$k"/"$v"}
  done < <(printf '%s\n' "${VARS[@]}" | awk -F= '{ print length($1) "\t" $0 }' | sort -rn | cut -f2-)
  printf '%s\n' "$content" > "$dst"
}

# Переменные вида $ИМЯ, оставшиеся после подстановки: те, которым скрипт сам ничего
# не присваивает (без строк-комментариев и обычных переменных окружения)
leftover_vars() {
  local f=$1 own
  own=$(grep -oE '(^|[;&|({[:space:]])(export[[:space:]]+|local[[:space:]]+|readonly[[:space:]]+)?[A-Z][A-Z0-9_]{2,}=' "$f" \
        | grep -oE '[A-Z][A-Z0-9_]{2,}=$' | tr -d '=' | sort -u)
  own+=$'\n'"HOME"$'\n'"PATH"$'\n'"USER"$'\n'"PWD"$'\n'"RANDOM"$'\n'"HOSTNAME"$'\n'"UID"$'\n'"EUID"
  grep -vE '^[[:space:]]*#' "$f" | grep -oE '\$[A-Z][A-Z0-9_]{2,}' | cut -c2- | sort -u \
    | grep -vxF -f <(printf '%s\n' "$own" | grep .) | sed 's/^/$/' | tr '\n' ' ' | sed 's/ $//'
}

# Подставляет переменные и проверяет, что ничего не осталось. Иначе релиз изменился так,
# что вслепую выполнять скрипт нельзя.
render_checked() {   # render_checked SRC DST CONTAINER
  local left
  render "$1" "$2"
  left=$(leftover_vars "$2")
  [[ -z $left ]] && return 0
  fail "$3: в $(basename "$1") из релиза $UP_TAG новые параметры ($left), нужна новая версия $PROG или установка через приложение"
  return 1
}

# run_container.sh в приложении состоит только из команд docker. Если в новой версии
# появилось что-то другое, не выполняем его вслепую.
docker_only_script() {
  local bad
  bad=$(awk '{ if (sub(/\\[[:space:]]*$/, "")) { buf = buf $0 " "; next } print buf $0; buf = "" }
             END { if (buf != "") print buf }' "$1" \
        | sed -E 's/^[[:space:]]+//' | grep -vE '^(#|$)' \
        | grep -vE '^(sudo[[:space:]]+(-[A-Za-z]+[[:space:]]+)*)?docker[[:space:]]')
  [[ -z $bad ]]
}

# Базовые образы из Dockerfile (FROM), без ссылок на стадии сборки
dockerfile_bases() {
  awk 'toupper($1) == "FROM" {
         img = ""
         for (i = 2; i <= NF; i++) { if ($i ~ /^--/) continue; img = $i; break }
         if (img != "" && !(img in stage) && img !~ /^\$/) print img
         for (i = 2; i < NF; i++) if (toupper($i) == "AS") stage[$(i + 1)] = 1
       }' "$1" | sort -u
}

# ---------------------------------------------------------------- docker
c_exists()  { docker container inspect "$1" >/dev/null 2>&1; }
c_running() { [[ $(docker container inspect -f '{{.State.Running}}' "$1" 2>/dev/null) == true ]]; }
c_image()   { docker container inspect -f '{{.Image}}' "$1" 2>/dev/null; }
# Версии программ в работающем контейнере, например "xray 26.10.31"
c_versions() {
  local c=$1 probe bin v out=""
  for probe in ${VERSION_PROBES[$c]:-}; do
    bin=${probe%%:*}
    v=$(timeout 10 docker exec "$c" "$bin" "${probe#*:}" 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
    [[ -n $v ]] && out+="${out:+, }$bin $v"
  done
  printf '%s' "$out"
}
c_restart_policy() { docker container inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$1" 2>/dev/null; }
img_layers() { docker image inspect -f '{{range .RootFS.Layers}}{{println .}}{{end}}' "$1" 2>/dev/null; }

list_amnezia_containers() {
  docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^amnezia-' | grep -vE -- '-aau-prev$' | sort
}

# Образ контейнера собран поверх текущей версии базового образа?
built_on_base() {
  local img=$1 base=$2 il bl
  bl=$(img_layers "$base") || return 1
  il=$(img_layers "$img") || return 1
  [[ -n $bl && $il == "$bl"* ]]
}

# Опубликованные порты контейнера: строки "55424/udp 55424"
published_ports() {
  docker container inspect -f '{{range $p, $b := .HostConfig.PortBindings}}{{$p}}{{range $b}} {{.HostPort}}{{end}}{{println}}{{end}}' "$1" 2>/dev/null \
    | grep -v '^$'
}

ensure_dns_network() {
  docker network inspect "$DNS_NET" >/dev/null 2>&1 && return 0
  # та же команда, что в prepare_host.sh приложения
  docker network create --driver bridge --subnet=172.29.172.0/24 \
    --opt com.docker.network.bridge.name=amn0 "$DNS_NET" >/dev/null
}

# ---------------------------------------------------------------- настройки протоколов
# У AmneziaDNS нет своего состояния (ключей и пользователей), его достаточно пересобрать
has_state() { [[ $1 != amnezia-dns ]]; }

conf_get() {   # conf_get FILE KEY -> значение строки "KEY = VALUE"
  awk -v k="$2" '{
      line = $0; sub(/\r$/, "", line)
      split(line, a, "="); key = a[1]; gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (key == k) { sub(/^[^=]*=[ \t]*/, "", line); sub(/[ \t]+$/, "", line); print line; exit }
    }' "$1" 2>/dev/null
}

base_vars() {
  local c=$1 ip
  ip=$(primary_ip)
  VARS=(
    "CONTAINER_NAME=$c"
    "DOCKERFILE_FOLDER=/opt/amnezia/$c"
    "REMOTE_HOST=${ip:-127.0.0.1}"
    "SERVER_IP_ADDRESS=${ip:-127.0.0.1}"
    "PRIMARY_SERVER_DNS=8.8.8.8"
    "SECONDARY_SERVER_DNS=8.8.4.4"
  )
}

# Файлы конфигурации внутри /opt/amnezia контейнера
wg_conf_rel() {
  case $1 in
    amnezia-awg2) echo awg/awg0.conf ;;
    amnezia-awg) echo awg/wg0.conf ;;
    amnezia-wireguard) echo wireguard/wg0.conf ;;
  esac
}
wg_pubkey_rel() {
  case $1 in
    amnezia-awg2|amnezia-awg) echo awg/wireguard_server_public_key.key ;;
    amnezia-wireguard) echo wireguard/wireguard_server_public_key.key ;;
  esac
}
wg_tool() {
  case $1 in
    amnezia-awg2) echo "awg awg0" ;;
    amnezia-awg|amnezia-wireguard) echo "wg wg0" ;;
  esac
}

# Достаёт порт и подсеть из сохранённой копии /opt/amnezia контейнера -> VARS
extract_vars() {
  local c=$1 dir=$2 conf port addr ip cidr
  base_vars "$c"
  EXPECT_PORT=""
  case $c in
    amnezia-awg2|amnezia-awg|amnezia-wireguard)
      conf="$dir/$(wg_conf_rel "$c")"
      [[ -f $conf ]] || { fail "$c: в контейнере нет $(wg_conf_rel "$c")"; return 1; }
      port=$(conf_get "$conf" ListenPort)
      addr=$(conf_get "$conf" Address)
      ip=${addr%%/*}
      cidr=${addr#*/}
      [[ $cidr == "$addr" ]] && cidr=$DEFAULT_SUBNET_CIDR
      if ! valid_port "$port" || ! valid_ipv4 "$ip" || ! [[ $cidr =~ ^[0-9]{1,2}$ ]]; then
        fail "$c: не смог прочитать ListenPort/Address из $(wg_conf_rel "$c")"
        return 1
      fi
      if [[ $c == amnezia-wireguard ]]; then
        VARS+=("WIREGUARD_SERVER_PORT=$port" "WIREGUARD_SUBNET_IP=$ip" "WIREGUARD_SUBNET_CIDR=$cidr")
      else
        VARS+=("AWG_SERVER_PORT=$port" "AWG_SUBNET_IP=$ip" "WIREGUARD_SUBNET_CIDR=$cidr")
      fi
      EXPECT_PORT=$port
      ;;
    amnezia-xray)
      conf="$dir/xray/server.json"
      [[ -f $conf ]] || { fail "$c: в контейнере нет xray/server.json"; return 1; }
      port=$(jq -r '.inbounds[0].port // empty' "$conf" 2>/dev/null)
      valid_port "$port" || { fail "$c: не смог прочитать порт из server.json"; return 1; }
      VARS+=("XRAY_SERVER_PORT=$port")
      EXPECT_PORT=$port
      ;;
    amnezia-dns) ;;
  esac
  return 0
}

# Порт в конфиге должен совпадать с опубликованным портом контейнера (так ставит приложение)
check_published_port() {
  local c=$1
  [[ -z $EXPECT_PORT ]] && return 0
  if ! published_ports "$c" | grep -qE "^${EXPECT_PORT}/(udp|tcp) ${EXPECT_PORT}( |$)"; then
    fail "$c: порт $EXPECT_PORT из конфига не совпадает с портами контейнера ($(published_ports "$c" | tr '\n' ';')), не трогаю"
    return 1
  fi
}

# Что должно получиться после обновления: тот же ключ сервера и не меньше клиентов.
# Берём из работающего старого контейнера, а если его интерфейс не поднят, из конфига.
set_expectations() {
  local c=$1 dir=$2 tool ifc pub n
  EXPECT_PUBKEY=""
  EXPECT_PEERS=""
  case $c in
    amnezia-awg2|amnezia-awg|amnezia-wireguard)
      read -r tool ifc <<< "$(wg_tool "$c")"
      pub=$(docker exec "$c" "$tool" show "$ifc" public-key 2>/dev/null) || pub=""
      if [[ -n $pub ]]; then
        n=$(docker exec "$c" "$tool" show "$ifc" peers 2>/dev/null | grep -c .)
      else
        pub=$(tr -d '[:space:]' < "$dir/$(wg_pubkey_rel "$c")" 2>/dev/null)
        n=$(grep -cE '^[[:space:]]*\[Peer\]' "$dir/$(wg_conf_rel "$c")" 2>/dev/null)
      fi
      EXPECT_PUBKEY=$pub
      EXPECT_PEERS=${n:-0}
      ;;
  esac
}

# Интерфейс слушает нужный порт? amneziawg-go (userspace) на сервере без IPv6 показывает
# listen-port 0, хотя порт открыт, поэтому тогда смотрим на сокет в контейнере.
wg_port_ok() {
  local c=$1 tool=$2 ifc=$3 v
  v=$(docker exec "$c" "$tool" show "$ifc" listen-port 2>/dev/null) || return 1
  [[ $v == "$EXPECT_PORT" ]] && return 0
  [[ $v == 0 ]] || return 1
  docker exec "$c" sh -c "netstat -lnu 2>/dev/null | grep -q ':${EXPECT_PORT} '"
}

probe() {
  local c=$1 tool ifc v n
  case $c in
    amnezia-awg2|amnezia-awg|amnezia-wireguard)
      read -r tool ifc <<< "$(wg_tool "$c")"
      wg_port_ok "$c" "$tool" "$ifc" || return 1
      if [[ -n $EXPECT_PUBKEY ]]; then
        v=$(docker exec "$c" "$tool" show "$ifc" public-key 2>/dev/null) || return 1
        [[ $v == "$EXPECT_PUBKEY" ]] || return 1
      fi
      if [[ -n $EXPECT_PEERS ]]; then
        n=$(docker exec "$c" "$tool" show "$ifc" peers 2>/dev/null | grep -c .)
        (( n >= EXPECT_PEERS )) || return 1
      fi
      ;;
    amnezia-xray)
      docker exec "$c" sh -c "pidof xray >/dev/null 2>&1 && netstat -ltn 2>/dev/null | grep -q ':${EXPECT_PORT} '" || return 1
      ;;
    *)
      [[ $(docker container inspect -f '{{.State.Restarting}}' "$c" 2>/dev/null) == false ]] || return 1
      ;;
  esac
  return 0
}

health_check() {
  local c=$1 deadline=$((SECONDS + HEALTH_TIMEOUT))
  while (( SECONDS < deadline )); do
    sleep 3
    if c_running "$c" && probe "$c"; then
      sleep 3
      if c_running "$c" && probe "$c"; then return 0; fi
    fi
  done
  return 1
}

# Проверка нового образа до остановки старого контейнера
preflight() {
  local c=$1 img=$2 dir=$3
  case $c in
    amnezia-awg2)
      docker run --rm --entrypoint sh "$img" -c 'command -v awg && command -v awg-quick' >/dev/null 2>&1 ;;
    amnezia-awg|amnezia-wireguard)
      docker run --rm --entrypoint sh "$img" -c 'command -v wg && command -v wg-quick' >/dev/null 2>&1 ;;
    amnezia-xray)
      docker run --rm --entrypoint /usr/bin/xray -v "$dir/xray:/opt/amnezia/xray:ro" "$img" \
        run -test -config /opt/amnezia/xray/server.json >/dev/null 2>&1 ;;
    *) return 0 ;;
  esac
}

# ---------------------------------------------------------------- обновление контейнера
# Прошлое обновление прервалось (выключение, сбой)? Возвращаем прежний контейнер.
recover_leftovers() {
  local c=$1 prev="$1-aau-prev"
  c_exists "$prev" || return 0
  if (( DRY_RUN )); then
    warn "$c: найден контейнер $prev от прерванного обновления, при запуске он будет возвращён"
    return 0
  fi
  warn "$c: прошлое обновление не завершилось, возвращаю прежний контейнер"
  docker rm -f "$c" >/dev/null 2>&1
  docker rename "$prev" "$c" >/dev/null 2>&1 || { fail "$c: не смог переименовать $prev"; return 1; }
  docker update --restart always "$c" >/dev/null 2>&1
  docker start "$c" >/dev/null 2>&1 || fail "$c: не смог запустить прежний контейнер"
  docker image rm "$c:aau-new" >/dev/null 2>&1
  return 0
}

# Нужно ли обновление? Сравниваем с тем, из чего собран текущий контейнер. Причина в REASON.
needs_update() {
  local c=$1 up="$UP/${FOLDER_OF[$1]}" img base created age reasons=()
  img=$(c_image "$c")
  if [[ ! -f /opt/amnezia/$c/Dockerfile ]] \
     || ! cmp -s <(tr -d '\r' < "/opt/amnezia/$c/Dockerfile") "$up/Dockerfile"; then
    reasons+=("новый Dockerfile")
  fi
  while IFS= read -r base; do
    [[ -z $base ]] && continue
    if docker pull -q "$base" >/dev/null 2>&1; then
      built_on_base "$img" "$base" || reasons+=("новый базовый образ $base")
    else
      warn "$c: не удалось скачать $base, базовый образ не проверен"
    fi
  done < <(dockerfile_bases "$up/Dockerfile")
  if (( FORCE_REBUILD_DAYS > 0 )); then
    created=$(docker image inspect -f '{{.Created}}' "$img" 2>/dev/null)
    created=$(date -d "$created" +%s 2>/dev/null || echo 0)
    age=$(( ($(date +%s) - created) / 86400 ))
    (( age >= FORCE_REBUILD_DAYS )) && reasons+=("образу ${age} дн.")
  fi
  (( FORCE )) && reasons+=("принудительно")
  REASON=$(printf '%s, ' "${reasons[@]}")
  REASON=${REASON%, }
  (( ${#reasons[@]} > 0 ))
}

rollback() {
  local c=$1 prev=$2 old_img=$3 policy=$4 why=$5
  fail "$c: $why, возвращаю прежний контейнер"
  docker rm -f "$c" >/dev/null 2>&1
  if docker rename "$prev" "$c" >/dev/null 2>&1; then
    docker tag "$old_img" "$c:latest" >/dev/null 2>&1
    docker update --restart "${policy:-always}" "$c" >/dev/null 2>&1
    docker start "$c" >/dev/null 2>&1
    if health_check "$c"; then
      log "$c: прежний контейнер снова работает"
    else
      fail "$c: прежний контейнер не прошёл проверку, нужна ручная проверка (копия: $CUR_BACKUP)"
    fi
  else
    fail "$c: не смог вернуть прежний контейнер, нужна ручная проверка (копия: $CUR_BACKUP)"
  fi
  docker image rm "$c:aau-new" >/dev/null 2>&1
}

# Скрипты запуска из релиза с текущими портом и подсетью -> RUN_SCRIPT, START_NEW
prepare_run_scripts() {
  local c=$1 up="$UP/${FOLDER_OF[$1]}" left
  RUN_SCRIPT="$WORK/run-$c.sh"
  START_NEW=""
  render "$up/run_container.sh" "$RUN_SCRIPT"
  left=$(leftover_vars "$RUN_SCRIPT")
  if [[ -n $left ]] || ! docker_only_script "$RUN_SCRIPT"; then
    fail "$c: run_container.sh в релизе $UP_TAG изменился (${left:-не только команды docker}), нужна проверка вручную"
    return 1
  fi
  if [[ -f $up/start.sh ]]; then
    render "$up/start.sh" "$WORK/start-$c.sh"
    left=$(leftover_vars "$WORK/start-$c.sh")
    if [[ -z $left ]]; then
      START_NEW="$WORK/start-$c.sh"
    else
      warn "$c: в новом start.sh незнакомые переменные ($left), оставляю прежний start.sh"
    fi
  fi
  return 0
}

# Переносит сохранённое /opt/amnezia (ключи, клиенты, start.sh) в контейнер и перезапускает его
start_with_state() {
  local c=$1 dir=$2
  has_state "$c" || return 0
  docker cp "$dir/." "$c:/opt/amnezia/" >/dev/null 2>&1 || return 1
  if [[ -n $START_NEW ]]; then
    docker cp "$START_NEW" "$c:/opt/amnezia/start.sh" >/dev/null 2>&1 || return 1
  fi
  docker exec "$c" chmod a+x /opt/amnezia/start.sh >/dev/null 2>&1
  docker restart -t 5 "$c" >/dev/null 2>&1
}

# Проверка; если с новым start.sh не заработало, пробуем сохранённый
verify_started() {
  local c=$1 dir=$2
  health_check "$c" && return 0
  if [[ -n $START_NEW && -f $dir/start.sh ]]; then
    warn "$c: с новым start.sh проверка не прошла, пробую прежний start.sh"
    docker cp "$dir/start.sh" "$c:/opt/amnezia/start.sh" >/dev/null 2>&1
    docker exec "$c" chmod a+x /opt/amnezia/start.sh >/dev/null 2>&1
    docker restart -t 5 "$c" >/dev/null 2>&1
    health_check "$c" && return 0
  fi
  return 1
}

# Кладём Dockerfile туда же, куда его кладёт приложение (по нему видно, из чего собран контейнер)
store_dockerfile() {
  local c=$1 owner=${2:-} up="$UP/${FOLDER_OF[$1]}"
  if [[ -d /opt/amnezia/$c ]]; then
    install -m 644 "$up/Dockerfile" "/opt/amnezia/$c/Dockerfile"
    chown --reference="/opt/amnezia/$c" "/opt/amnezia/$c/Dockerfile" 2>/dev/null
  else
    install -D -m 644 "$up/Dockerfile" "/opt/amnezia/$c/Dockerfile"
  fi
  if [[ -n $owner ]]; then chown "$owner" "/opt/amnezia/$c" "/opt/amnezia/$c/Dockerfile" 2>/dev/null; fi
  return 0
}

save_container_state() {
  local c=$1
  mkdir -p "$STATE_DIR/containers"
  {
    printf 'UPDATED_AT=%s\n' "$(date -Is)"
    printf 'UPSTREAM_TAG=%s\n' "$UP_TAG"
    printf 'REASON=%s\n' "$REASON"
    printf 'IMAGE_ID=%s\n' "$(c_image "$c")"
  } > "$STATE_DIR/containers/$c.state"
}

update_container() {
  local c=$1 up="$UP/${FOLDER_OF[$1]}" prev="$1-aau-prev" new="$1:aau-new"
  local stamp bk old_img policy extra="" old_vers new_vers

  recover_leftovers "$c" || return 1
  if ! c_running "$c"; then
    log "$c: контейнер остановлен, пропускаю"
    return 0
  fi
  old_vers=$(c_versions "$c")
  if ! needs_update "$c"; then
    log "$c: актуален (${old_vers:+$old_vers, }релиз Amnezia $UP_TAG)"
    return 0
  fi
  log "$c: нужно обновление: $REASON${old_vers:+ (сейчас: $old_vers)}"
  (( DRY_RUN )) && return 0

  if ! ensure_free_space "$(docker_root)"; then
    fail "$c: на диске меньше ${MIN_FREE_MB} МБ даже после очистки, обновление пропущено"
    return 1
  fi

  [[ -n $RUN_STAMP ]] || RUN_STAMP=$(date +%Y%m%d-%H%M%S)
  stamp=$RUN_STAMP
  bk="$BACKUP_ROOT/$stamp/$c"
  CUR_BACKUP=$bk
  mkdir -p "$bk/opt-amnezia"
  # 1. Копия состояния, пока контейнер работает
  if has_state "$c" && ! docker cp "$c:/opt/amnezia/." "$bk/opt-amnezia/" >/dev/null 2>&1; then
    fail "$c: не смог скопировать /opt/amnezia из контейнера, обновление пропущено"
    return 1
  fi
  docker container inspect "$c" > "$bk/container.json" 2>/dev/null
  extract_vars "$c" "$bk/opt-amnezia" || return 1
  check_published_port "$c" || return 1
  old_img=$(c_image "$c")
  policy=$(c_restart_policy "$c")
  set_expectations "$c" "$bk/opt-amnezia"

  # 2. Сборка нового образа, старый контейнер в это время работает
  mkdir -p "$WORK/build/$c"
  cp "$up/Dockerfile" "$WORK/build/$c/Dockerfile"
  log "$c: собираю образ по Dockerfile из релиза $UP_TAG"
  if ! docker build --no-cache --pull -t "$new" "$WORK/build/$c" > "$bk/build.log" 2>&1; then
    tail -n 15 "$bk/build.log"
    fail "$c: сборка образа не удалась, контейнер не тронут (лог: $bk/build.log)"
    docker image rm "$new" >/dev/null 2>&1
    docker builder prune -af >/dev/null 2>&1
    return 1
  fi
  if ! preflight "$c" "$new" "$bk/opt-amnezia"; then
    fail "$c: новый образ не прошёл предварительную проверку, контейнер не тронут"
    docker image rm "$new" >/dev/null 2>&1
    return 1
  fi
  if ! prepare_run_scripts "$c"; then
    docker image rm "$new" >/dev/null 2>&1
    return 1
  fi
  if ! ensure_dns_network; then
    fail "$c: не смог создать сеть $DNS_NET"
    docker image rm "$new" >/dev/null 2>&1
    return 1
  fi

  # 3. Переключение: с этого момента VPN недоступен несколько секунд
  log "$c: останавливаю старый контейнер"
  if ! docker stop -t 10 "$c" >/dev/null 2>&1; then
    fail "$c: не смог остановить контейнер"
    docker image rm "$new" >/dev/null 2>&1
    return 1
  fi
  # Финальная копия уже из остановленного контейнера: ничего не потеряется,
  # даже если клиента добавили во время сборки
  if ! has_state "$c"; then
    :
  elif docker cp "$c:/opt/amnezia/." "$bk/opt-amnezia.final/" >/dev/null 2>&1; then
    rm -rf "$bk/opt-amnezia"
    mv "$bk/opt-amnezia.final" "$bk/opt-amnezia"
  else
    rm -rf "$bk/opt-amnezia.final"
    warn "$c: не смог повторно скопировать /opt/amnezia, использую копию до остановки"
  fi
  docker update --restart no "$c" >/dev/null 2>&1   # чтобы после внезапной перезагрузки не запустились оба
  if ! docker rename "$c" "$prev" >/dev/null 2>&1; then
    docker update --restart "${policy:-always}" "$c" >/dev/null 2>&1
    docker start "$c" >/dev/null 2>&1
    fail "$c: не смог переименовать старый контейнер"
    docker image rm "$new" >/dev/null 2>&1
    return 1
  fi
  docker tag "$new" "$c:latest" >/dev/null 2>&1

  log "$c: запускаю новый контейнер (run_container.sh из релиза $UP_TAG)"
  bash "$RUN_SCRIPT" > "$bk/run.log" 2>&1
  if ! c_exists "$c"; then
    cat "$bk/run.log"
    rollback "$c" "$prev" "$old_img" "$policy" "новый контейнер не создался"
    return 1
  fi

  # 4. Перенос ключей, клиентов и start.sh, проверка
  if ! start_with_state "$c" "$bk/opt-amnezia"; then
    rollback "$c" "$prev" "$old_img" "$policy" "не смог перенести /opt/amnezia в новый контейнер"
    return 1
  fi
  if ! verify_started "$c" "$bk/opt-amnezia"; then
    rollback "$c" "$prev" "$old_img" "$policy" "новый контейнер не прошёл проверку"
    return 1
  fi

  # 5. Готово: убираем старое
  docker rm -f "$prev" >/dev/null 2>&1
  docker image rm "$new" >/dev/null 2>&1
  store_dockerfile "$c"
  save_container_state "$c"
  docker image prune -f >/dev/null 2>&1
  docker builder prune -af >/dev/null 2>&1
  new_vers=$(c_versions "$c")
  if [[ $new_vers != "$old_vers" ]]; then
    extra="; было: ${old_vers:-?}; стало: ${new_vers:-?}"
  elif [[ -n $new_vers ]]; then
    extra="; версии те же: $new_vers"
  fi
  [[ -n $EXPECT_PEERS ]] && extra+="; клиентов: $EXPECT_PEERS"
  change "$c обновлён до релиза Amnezia $UP_TAG ($REASON)$extra"
  return 0
}

# Оставляем KEEP_BACKUPS последних копий каждого контейнера, пустые папки запусков убираем
prune_backups() {
  [[ -d $BACKUP_ROOT ]] || return 0
  local c d
  while IFS= read -r c; do
    [[ -z $c ]] && continue
    find "$BACKUP_ROOT" -mindepth 2 -maxdepth 2 -type d -path "$BACKUP_ROOT/20*/$c" -printf '%P\n' 2>/dev/null \
      | sort -r | tail -n +$((KEEP_BACKUPS + 1)) | while read -r d; do rm -rf "${BACKUP_ROOT:?}/$d"; done
  done < <(find "$BACKUP_ROOT" -mindepth 2 -maxdepth 2 -type d -path "$BACKUP_ROOT/20*/*" -printf '%f\n' 2>/dev/null | sort -u)
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*' -empty -delete 2>/dev/null
  return 0
}

update_containers() {
  if ! have_docker; then
    log "Docker не запущен или не установлен, контейнеров Amnezia нет"
    return 0
  fi
  local c all=() handled=" "
  mapfile -t all < <(list_amnezia_containers)
  if (( ${#all[@]} == 0 )); then
    log "контейнеров Amnezia на сервере нет"
    return 0
  fi
  prepare_upstream || return 1
  for c in "${UPDATE_ORDER[@]}"; do
    [[ -n $ONLY && $ONLY != "$c" ]] && continue
    if printf '%s\n' "${all[@]}" | grep -qx -- "$c"; then
      update_container "$c"
      handled+="$c "
    fi
  done
  for c in "${all[@]}"; do
    [[ $handled == *" $c "* ]] && continue
    [[ -n $ONLY && $ONLY != "$c" ]] && continue
    log "$c: автообновление этого контейнера не поддерживается, обновляй через приложение"
  done
  (( DRY_RUN )) || prune_backups
  return 0
}

# ---------------------------------------------------------------- ОС
os_update() {
  log "обновляю пакеты ОС"
  ensure_free_space / || warn "на диске меньше ${MIN_FREE_MB} МБ свободного места"
  if command -v apt-get >/dev/null 2>&1; then
    local o=(-o DPkg::Lock::Timeout=1800 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
    local rc n up_n new_n
    export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l   # l: только список; с "a" needrestart мог бы перезапустить и сам этот сервис посреди apt
    dpkg --force-confdef --force-confold --configure -a >/dev/null 2>&1
    if ! apt-get "${o[@]}" -yq update > "$WORK/apt-update.log" 2>&1; then
      tail -n 15 "$WORK/apt-update.log"
      fail "apt-get update завершился с ошибкой"
      return 1
    fi
    apt-get "${o[@]}" -yq dist-upgrade 2>&1 | tee "$WORK/apt-upgrade.log" | grep -E '^(Setting up|Unpacking|Removing) ' | sed 's/^/  /'
    rc=${PIPESTATUS[0]}
    if (( rc != 0 )); then
      tail -n 20 "$WORK/apt-upgrade.log"
      fail "apt-get dist-upgrade завершился с кодом $rc"
      return 1
    fi
    n=$(sed -nE 's/^([0-9]+) upgraded, ([0-9]+) newly installed, ([0-9]+) to remove.*/\1 \2 \3/p' "$WORK/apt-upgrade.log" | head -1)
    apt-get "${o[@]}" -yq autoremove --purge > "$WORK/apt-autoremove.log" 2>&1 || warn "apt-get autoremove завершился с ошибкой"
    apt-get clean >/dev/null 2>&1
    read -r up_n new_n _ <<< "${n:-0 0 0}"
    if (( up_n + new_n > 0 )); then
      change "ОС: обновлено пакетов: $up_n, установлено новых: $new_n"
    else
      log "ОС: обновлений нет"
    fi
  elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
    local pm
    pm=$(command -v dnf || command -v yum)
    if "$pm" -y upgrade --refresh > "$WORK/dnf.log" 2>&1 || "$pm" -y update > "$WORK/dnf.log" 2>&1; then
      if grep -qE '^(Upgraded|Installed):' "$WORK/dnf.log"; then change "ОС: пакеты обновлены ($pm)"; else log "ОС: обновлений нет"; fi
      "$pm" -y autoremove >/dev/null 2>&1
      "$pm" clean all >/dev/null 2>&1
    else
      tail -n 20 "$WORK/dnf.log"
      fail "$pm upgrade завершился с ошибкой"
      return 1
    fi
  else
    warn "менеджер пакетов не найден (нужен apt-get, dnf или yum), ОС не обновляю"
  fi
  return 0
}

# Установлено ядро новее работающего той же сборки (generic, cloud-amd64 и т.п.)?
# Печатает его версию. Нужно для Debian: он сам не создаёт /var/run/reboot-required.
installed_newer_kernel() {
  local running flavor newest
  running=$(uname -r)
  flavor=$(sed -nE 's/^[0-9]+\.[0-9]+[^-]*-[0-9]+[^-]*-(.+)$/\1/p' <<< "$running")
  newest=$(find /boot -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null | sed 's/^vmlinuz-//' \
           | grep -E -- "${flavor:+-${flavor}}\$" | sort -V | tail -1)
  [[ -n $newest && $newest != "$running" ]] || return 1
  [[ $(printf '%s\n' "$newest" "$running" | sort -V | tail -1) == "$newest" ]] || return 1
  printf '%s' "$newest"
}

# Ради этого ядра уже перезагружались, а загрузилось другое: второй раз не перезагружаем
kernel_reboot_tried() { [[ -n $1 && $(cat "$STATE_DIR/reboot-kernel" 2>/dev/null) == "$1" ]]; }

reboot_required() {
  local k
  [[ -f /var/run/reboot-required ]] && return 0
  if command -v needs-restarting >/dev/null 2>&1; then
    needs-restarting -r >/dev/null 2>&1
    [[ $? -eq 1 ]] && return 0
  fi
  if k=$(installed_newer_kernel) && ! kernel_reboot_tried "$k"; then return 0; fi
  return 1
}

reboot_reason() {
  local k
  if [[ -f /var/run/reboot-required.pkgs ]]; then
    sort -u /var/run/reboot-required.pkgs | tr '\n' ' ' | sed 's/ $//'
  elif k=$(installed_newer_kernel); then
    echo "установлено ядро $k, работает $(uname -r)"
  else
    echo "обновление ядра или системных библиотек"
  fi
}

# ---------------------------------------------------------------- настройки хоста
# setup_host_firewall.sh приложение запускает только при установке протокола, а его
# sysctl и правила iptables не переживают перезагрузку. Применяем заново.
host_setup() {
  [[ $HOST_SETUP == yes ]] || return 0
  have_docker || return 0
  [[ -n $(list_amnezia_containers) ]] || return 0
  local script=""
  if [[ -n $UP && -f $UP/setup_host_firewall.sh ]]; then
    script=$UP/setup_host_firewall.sh
  elif [[ -f $STATE_DIR/upstream/current/setup_host_firewall.sh ]]; then
    script=$STATE_DIR/upstream/current/setup_host_firewall.sh
  elif prepare_upstream; then
    script=$UP/setup_host_firewall.sh
  fi
  if [[ -z $script || ! -f $script ]]; then
    warn "нет setup_host_firewall.sh, настройки хоста не применены"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  bash "$script" > "$STATE_DIR/host-setup.log" 2>&1
  log "сетевые настройки хоста применены (setup_host_firewall.sh, лог: $STATE_DIR/host-setup.log)"
}

# ---------------------------------------------------------------- развёртывание с нуля
port_busy() {   # port_busy PORT udp|tcp
  local flag=-lnt
  [[ $2 == udp ]] && flag=-lnu
  ss -H "$flag" "sport = :$1" 2>/dev/null | grep -q .
}

# Скрипт внутри контейнера, как SshSession::runContainerScript в приложении
run_in_container() {   # run_in_container CONTAINER FILE [sh|bash]
  local c=$1 f=$2 sh=${3:-bash} name
  name="/opt/amnezia/aau-$RANDOM$RANDOM.sh"
  docker exec -i "$c" mkdir -p /opt/amnezia || return 1
  docker cp "$f" "$c:$name" >/dev/null || return 1
  docker exec -i "$c" "$sh" "$name"
  local rc=$?
  docker exec -i "$c" rm -f "$name" >/dev/null 2>&1
  return $rc
}

# Параметры AmneziaWG как в AwgInstaller::generateAwgParameters приложения.
# HeaderProtectionKey это случайный ключ WireGuard, его даёт awg genkey из собранного образа.
awg2_vars() {
  local img=$1 hpk
  hpk=$(docker run --rm --entrypoint awg "$img" genkey 2>/dev/null | tr -d '[:space:]')
  [[ -n $hpk ]] || return 1
  VARS+=(
    "JUNK_PACKET_COUNT=$((4 + RANDOM % 3))"
    "JUNK_PACKET_MIN_SIZE=10"
    "JUNK_PACKET_MAX_SIZE=50"
    "INIT_PACKET_JUNK_SIZE=12"
    "RESPONSE_PACKET_JUNK_SIZE=12"
    "COOKIE_REPLY_PACKET_JUNK_SIZE=12"
    "TRANSPORT_PACKET_JUNK_SIZE=12"
    "INIT_PACKET_MAGIC_HEADER=1"
    "RESPONSE_PACKET_MAGIC_HEADER=2"
    "UNDERLOAD_PACKET_MAGIC_HEADER=3"
    "TRANSPORT_PACKET_MAGIC_HEADER=4"
    "SPECIAL_JUNK_1=" "SPECIAL_JUNK_2=" "SPECIAL_JUNK_3=" "SPECIAL_JUNK_4=" "SPECIAL_JUNK_5="
    "HEADER_PROTECTION_KEY=$hpk"
    "CONTENT_PADDING_ADDITION="
    "REKEY_AFTER_TIME=100-120"
    "REKEY_TIMEOUT=3-7"
    "REJECT_AFTER_TIME=150-180"
    "KEEPALIVE_TIMEOUT=5-15"
    "MAX_HANDSHAKE_ATTEMPTS=15-20"
    "RANDOM_TRAILERS=on"
    "DISABLE_COOKIES=on"
  )
}

# server.json как XrayServerConfig::toServerInboundJson приложения (REALITY, tcp, vision)
write_xray_server_json() {
  local c=$1 port=$2 site=$3 dst=$4 uuid priv sid
  uuid=$(docker exec "$c" cat /opt/amnezia/xray/xray_uuid.key 2>/dev/null | tr -d '[:space:]')
  priv=$(docker exec "$c" cat /opt/amnezia/xray/xray_private.key 2>/dev/null | tr -d '[:space:]')
  sid=$(docker exec "$c" cat /opt/amnezia/xray/xray_short_id.key 2>/dev/null | tr -d '[:space:]')
  [[ -n $uuid && -n $priv && -n $sid ]] || return 1
  jq -n --argjson port "$port" --arg uuid "$uuid" --arg pk "$priv" --arg sid "$sid" --arg site "$site" '{
    inbounds: [{
      port: $port,
      protocol: "vless",
      settings: { clients: [{ flow: "xtls-rprx-vision", id: $uuid }], decryption: "none" },
      streamSettings: {
        network: "tcp",
        realitySettings: { dest: ($site + ":443"), privateKey: $pk, serverNames: [$site], shortIds: [$sid] },
        security: "reality"
      }
    }],
    log: { loglevel: "error" },
    outbounds: [{ protocol: "freedom" }]
  }' > "$dst"
}

# Новый контейнер не настроился: убираем его, чтобы не осталось полуготового протокола.
# Volume xray не трогаем: там могут быть ключи прежней установки.
deploy_failed() {
  fail "$1: $2"
  docker rm -f "$1" >/dev/null 2>&1
  return 1
}

deploy_one() {
  local proto=$1 port=$2 site=$3 c proto_net owner=${DEPLOY_OWNER:-}
  case $proto in
    awg|awg2|amneziawg) c=amnezia-awg2; port=${port:-$DEFAULT_AWG_PORT}; proto_net=udp ;;
    wireguard|wg) c=amnezia-wireguard; port=${port:-$DEFAULT_WG_PORT}; proto_net=udp ;;
    xray|vless|reality) c=amnezia-xray; port=${port:-$DEFAULT_XRAY_PORT}; proto_net=tcp ;;
    dns|amneziadns) c=amnezia-dns; port=""; proto_net="" ;;
    *) fail "неизвестный протокол: $proto (можно: awg, xray, wireguard, dns)"; return 1 ;;
  esac
  local up="$UP/${FOLDER_OF[$c]}"
  if c_exists "$c"; then
    log "$c уже установлен, пропускаю (обновлять его будет автообновление)"
    return 0
  fi
  if [[ -n $port ]]; then
    valid_port "$port" || { fail "$c: неверный порт $port"; return 1; }
    if port_busy "$port" "$proto_net"; then fail "$c: порт $port/$proto_net уже занят"; return 1; fi
  fi
  ensure_free_space "$(docker_root)" || warn "мало свободного места на диске"
  log "$c: устанавливаю по скриптам релиза $UP_TAG"

  base_vars "$c"
  case $c in
    amnezia-awg2) VARS+=("AWG_SERVER_PORT=$port" "AWG_SUBNET_IP=$DEFAULT_SUBNET_IP" "WIREGUARD_SUBNET_CIDR=$DEFAULT_SUBNET_CIDR") ;;
    amnezia-xray) VARS+=("XRAY_SERVER_PORT=$port" "XRAY_SITE_NAME=${site:-$DEFAULT_XRAY_SITE}") ;;
    amnezia-wireguard) VARS+=("WIREGUARD_SERVER_PORT=$port" "WIREGUARD_SUBNET_IP=$DEFAULT_SUBNET_IP" "WIREGUARD_SUBNET_CIDR=$DEFAULT_SUBNET_CIDR") ;;
  esac

  # Сначала все скрипты релиза с подстановкой: если в релизе появились незнакомые
  # параметры, ничего на сервере не меняем
  render_checked "$UP/prepare_host.sh" "$WORK/prepare-$c.sh" "$c" || return 1
  render_checked "$UP/build_container.sh" "$WORK/build-$c.sh" "$c" || return 1
  render_checked "$up/run_container.sh" "$WORK/run-$c.sh" "$c" || return 1
  if ! docker_only_script "$WORK/run-$c.sh"; then
    fail "$c: в run_container.sh из релиза $UP_TAG не только команды docker, нужна проверка вручную"
    return 1
  fi
  if [[ -f $up/start.sh ]]; then
    render_checked "$up/start.sh" "$WORK/start-$c.sh" "$c" || return 1
  fi

  # prepare_host.sh: папка /opt/amnezia/<контейнер> и сеть amnezia-dns-net
  bash "$WORK/prepare-$c.sh" >/dev/null 2>&1
  ensure_dns_network || { fail "$c: не смог создать сеть $DNS_NET"; return 1; }
  store_dockerfile "$c" "$owner"

  # build_container.sh
  if ! bash "$WORK/build-$c.sh" > "$WORK/build-$c.log" 2>&1 || ! docker image inspect "$c" >/dev/null 2>&1; then
    tail -n 20 "$WORK/build-$c.log"
    fail "$c: сборка образа не удалась"
    return 1
  fi

  # configure_container.sh (выполняется внутри контейнера)
  if [[ $c == amnezia-awg2 ]]; then
    awg2_vars "$c" || { fail "$c: не смог сгенерировать HeaderProtectionKey"; return 1; }
  fi
  if [[ -s $up/configure_container.sh ]]; then
    render_checked "$up/configure_container.sh" "$WORK/configure-$c.sh" "$c" || return 1
  fi

  # run_container.sh
  bash "$WORK/run-$c.sh" > "$WORK/run-$c.log" 2>&1
  if ! c_running "$c"; then
    cat "$WORK/run-$c.log"
    deploy_failed "$c" "контейнер не запустился"
    return 1
  fi

  if [[ -s $WORK/configure-$c.sh ]]; then
    if ! run_in_container "$c" "$WORK/configure-$c.sh" > "$WORK/configure-$c.log" 2>&1 \
       || grep -q 'amnezia_xray_keygen=failed' "$WORK/configure-$c.log"; then
      cat "$WORK/configure-$c.log"
      deploy_failed "$c" "настройка контейнера не удалась"
      return 1
    fi
  fi
  if [[ $c == amnezia-xray ]]; then
    if ! write_xray_server_json "$c" "$port" "${site:-$DEFAULT_XRAY_SITE}" "$WORK/server.json" \
       || ! docker cp "$WORK/server.json" "$c:/opt/amnezia/xray/server.json" >/dev/null; then
      deploy_failed "$c" "не смог записать server.json"
      return 1
    fi
  fi

  # setup_host_firewall.sh и start.sh, как в конце установки в приложении
  bash "$UP/setup_host_firewall.sh" > "$WORK/firewall.log" 2>&1
  if [[ -f $WORK/start-$c.sh ]]; then
    docker cp "$WORK/start-$c.sh" "$c:/opt/amnezia/start.sh" >/dev/null
    docker exec -d "$c" sh -c "chmod a+x /opt/amnezia/start.sh && /opt/amnezia/start.sh"
  fi

  EXPECT_PORT=$port
  EXPECT_PEERS=""
  EXPECT_PUBKEY=""
  [[ $c == amnezia-awg2 || $c == amnezia-wireguard ]] && EXPECT_PEERS=0
  if ! health_check "$c"; then
    docker logs --tail 20 "$c" 2>&1
    deploy_failed "$c" "контейнер установлен, но проверка не прошла, убрал его"
    return 1
  fi
  REASON="установка"
  save_container_state "$c"
  change "$c установлен (порт ${port:-нет}, релиз $UP_TAG)"
  return 0
}

# ---------------------------------------------------------------- перенос на другой сервер
ensure_docker() {
  have_docker && return 0
  log "ставлю Docker (install_docker.sh из релиза $UP_TAG)"
  bash "$UP/install_docker.sh" > "$WORK/install-docker.log" 2>&1
  if ! have_docker; then
    tail -n 20 "$WORK/install-docker.log"
    fail "не удалось установить Docker"
    return 1
  fi
  return 0
}

# Ожидания для импортированного контейнера: ключ сервера из PrivateKey, клиенты из конфига
set_import_expectations() {
  local c=$1 dir=$2 tool ifc priv conf
  EXPECT_PUBKEY=""
  EXPECT_PEERS=""
  case $c in
    amnezia-awg2|amnezia-awg|amnezia-wireguard)
      read -r tool ifc <<< "$(wg_tool "$c")"
      conf="$dir/$(wg_conf_rel "$c")"
      priv=$(conf_get "$conf" PrivateKey)
      EXPECT_PUBKEY=$(printf '%s\n' "$priv" | docker run --rm -i --entrypoint "$tool" "$c" pubkey 2>/dev/null)
      EXPECT_PEERS=$(grep -cE '^[[:space:]]*\[Peer\]' "$conf" 2>/dev/null)
      ;;
  esac
}

import_container() {
  local c=$1 dir=$2 proto_net=udp
  if c_exists "$c"; then
    fail "$c уже есть на этом сервере, импорт пропущен (сначала удали его в приложении Amnezia)"
    return 1
  fi
  extract_vars "$c" "$dir" || return 1
  [[ $c == amnezia-xray ]] && proto_net=tcp
  if [[ -n $EXPECT_PORT ]] && port_busy "$EXPECT_PORT" "$proto_net"; then
    fail "$c: порт $EXPECT_PORT/$proto_net на этом сервере уже занят"
    return 1
  fi
  ensure_free_space "$(docker_root)" || warn "мало свободного места на диске"
  log "$c: импортирую (порт ${EXPECT_PORT:-нет}) по скриптам релиза $UP_TAG"

  render "$UP/prepare_host.sh" "$WORK/prepare-$c.sh"
  bash "$WORK/prepare-$c.sh" >/dev/null 2>&1
  ensure_dns_network || { fail "$c: не смог создать сеть $DNS_NET"; return 1; }
  store_dockerfile "$c" "$DEPLOY_OWNER"
  render "$UP/build_container.sh" "$WORK/build-$c.sh"
  if ! bash "$WORK/build-$c.sh" > "$WORK/build-$c.log" 2>&1 || ! docker image inspect "$c" >/dev/null 2>&1; then
    tail -n 20 "$WORK/build-$c.log"
    fail "$c: сборка образа не удалась"
    return 1
  fi
  if ! preflight "$c" "$c" "$dir"; then
    fail "$c: новый образ не принимает сохранённую конфигурацию"
    return 1
  fi
  set_import_expectations "$c" "$dir"
  prepare_run_scripts "$c" || return 1
  bash "$RUN_SCRIPT" > "$WORK/run-$c.log" 2>&1
  if ! c_exists "$c"; then
    cat "$WORK/run-$c.log"
    fail "$c: контейнер не создался"
    return 1
  fi
  if ! start_with_state "$c" "$dir"; then
    fail "$c: не смог перенести /opt/amnezia в контейнер"
    return 1
  fi
  if ! verify_started "$c" "$dir"; then
    fail "$c: импортирован, но проверка не прошла (интерфейс, порт, ключ или клиенты)"
    return 1
  fi
  REASON="импорт"
  save_container_state "$c"
  change "$c импортирован${EXPECT_PEERS:+, клиентов: $EXPECT_PEERS}"
  return 0
}

cmd_export() {
  local out=${1:-} c stage n=0
  need_root
  exec 3>&1 1>&2        # журнал в stderr, чтобы "export -" отдавал в stdout только архив
  init_work
  have_docker || die "Docker не запущен, экспортировать нечего"
  [[ -z $out ]] && out="/root/amnezia-export-$(hostname -s 2>/dev/null || hostname)-$(date +%Y%m%d-%H%M%S).tar.gz"
  stage="$WORK/export"
  mkdir -p "$stage"
  while IFS= read -r c; do
    [[ -z $c ]] && continue
    if [[ -z ${FOLDER_OF[$c]:-} ]]; then
      warn "$c: перенос этого контейнера не поддерживается, в экспорт не попадёт"
      continue
    fi
    mkdir -p "$stage/$c/opt-amnezia"
    if has_state "$c" && ! docker cp "$c:/opt/amnezia/." "$stage/$c/opt-amnezia/" >/dev/null 2>&1; then
      fail "$c: не смог скопировать /opt/amnezia"
      rm -rf "${stage:?}/$c"
      continue
    fi
    docker container inspect "$c" > "$stage/$c/container.json" 2>/dev/null
    n=$((n + 1))
    log "$c: добавлен в экспорт"
  done < <(list_amnezia_containers)
  (( n > 0 )) || die "нечего экспортировать: нет поддерживаемых контейнеров Amnezia"
  printf 'FORMAT=1\nTOOL=%s %s\nHOST=%s\nIP=%s\nDATE=%s\n' \
    "$PROG" "$VERSION" "$(server_label)" "$(primary_ip)" "$(date -Is)" > "$stage/manifest"
  if [[ $out == - ]]; then
    tar -C "$stage" -czf - . >&3 || die "не смог записать архив"
  else
    tar -C "$stage" -czf "$out" . || die "не смог записать $out"
    chmod 600 "$out"
    log "экспорт готов: $out"
  fi
  log "в архиве приватные ключи сервера и клиентов, храни его как пароль"
  (( ${#ERRORS[@]} == 0 ))
}

cmd_import() {
  local file="" c n=0 old_ip new_ip
  while (( $# )); do
    case $1 in
      --owner) DEPLOY_OWNER=${2:-}; shift ;;
      -*) die "неизвестный параметр: $1" ;;
      *) file=$1 ;;
    esac
    shift
  done
  [[ -n $file && -f $file ]] || die "укажи файл экспорта: $PROG import /root/amnezia-export-....tar.gz"
  need_root
  init_work
  acquire_lock
  start_logging
  log "=== $PROG $VERSION: импорт из $file ==="
  mkdir -p "$WORK/import"
  tar --no-same-owner -xzf "$file" -C "$WORK/import" || die "не смог распаковать $file"
  [[ -f $WORK/import/manifest ]] || die "$file не похож на экспорт $PROG"
  log "экспорт сделан на $(sed -n 's/^HOST=//p' "$WORK/import/manifest"), $(sed -n 's/^DATE=//p' "$WORK/import/manifest")"
  old_ip=$(sed -n 's/^IP=//p' "$WORK/import/manifest")
  new_ip=$(primary_ip)
  if [[ -n $old_ip && -n $new_ip && $old_ip != "$new_ip" ]]; then
    warn "IP в экспорте $old_ip, у этого сервера $new_ip. Если в приложении сервер добавлен по IP, пользователям понадобятся новые конфиги"
  fi
  prepare_upstream || { finish_run; return 1; }
  ensure_docker || { finish_run; return 1; }
  for c in "${UPDATE_ORDER[@]}"; do
    [[ -d $WORK/import/$c/opt-amnezia ]] || continue
    import_container "$c" "$WORK/import/$c/opt-amnezia" && n=$((n + 1))
  done
  (( n > 0 )) && host_setup
  finish_run
  (( ${#ERRORS[@]} == 0 ))
}

